+Record {

	cpuAverage { :self |
		self['cpuAverage']
	}

	cpuPeak { :self |
		self['cpuPeak']
	}

	groupCount { :self |
		self['groupCount']
	}

	sampleRateActual { :self |
		self['sampleRateActual']
	}

	sampleRateNominal { :self |
		self['sampleRateNominal']
	}

	synthCount { :self |
		self['synthCount']
	}

	synthdefCount { :self |
		self['synthdefCount']
	}

	ugenCount { :self |
		self['ugenCount']
	}

}
