/* Meta: Kernel */

[
	/* Kernel Traits */
	'Object'
	'Cache'
	'Compare'
	'Copy'
	'Equal'
	'Json'
	'Number'
	'RandomNumberGenerator'
	'Store'
	'Binary' /* > Cache */
	'Integer' /* > Cache */

	/* Collection Traits */
	'Add'
	'ArithmeticProgression'
	'At'
	'Collect'
	'Do'
	'Collection'
	'Dictionary' /* @Collection */
	'Indices'
	'New'
	'Ordered'
	'Put'
	'Remove'
	'Sequence'
	'Set'
	'Unordered'

	/* Kernel Types */
	'Boolean'
	'Error'
	'Meta'
	'Nil'
	'Block'
	'Adverb' /* Block */
	'Promise'
	'Request'
	'SmallFloat'
	'Character'
	'String' /* Character */
	'System'

	/* Collection Types */
	'Association'
	'List'
	'Range'
	'Record'
	'Map' /* Record */
	'WeakMap'

	'Package' /* System, Record */

	'ArrayBuffer'
	'ByteArray'
	'Float32Array'
	'Float64Array'

	'BinaryLargeObject' /* ByteArray, Float64Array */

	'PrimitiveArray' /* ByteArray, Float32Array, Float64Array, List */
	'PrimitiveMap' /* Map, WeakMap */

	'Response'

].primitiveLoadPackageSequence
